{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/pwa-icon/192",
      "destination": "/icon-192.png"
    },
    {
      "source": "/api/pwa-icon/512",
      "destination": "/icon-512.png"
    },
    {
      "source": "/api/drive/image/:fileId",
      "destination": "/api/drive/image?id=:fileId"
    },
    {
      "source": "/api/sync/rev",
      "destination": "/api/sync/state?mode=rev"
    },
    {
      "source": "/api/sync/mutate",
      "destination": "/api/sync/state?mode=mutate"
    },
    {
      "source": "/api/sync/bulk",
      "destination": "/api/sync/state?mode=bulk"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
