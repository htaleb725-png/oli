{
  "entities": {
    "Visitor": {
      "title": "Visitor",
      "description": "Active visitor / citizen record filtered by department and operational status",
      "type": "object",
      "properties": {
        "Citizen_ID": { "type": "string" },
        "FullName": { "type": "string" },
        "Phone1": { "type": "string" },
        "District": { "type": "string" },
        "SubDistrict": { "type": "string" },
        "Gender": { "type": "string" },
        "Rating": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string" },
        "archivedInSections": { "type": "array", "items": { "type": "string" } },
        "CreatedAt": { "type": "string" },
        "UpdatedAt": { "type": "string" }
      },
      "required": ["Citizen_ID", "FullName", "CreatedAt"]
    },
    "ArchiveEntry": {
      "title": "ArchiveEntry",
      "description": "Independent per-department archive record separated from active visitors with restore support",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recordId": { "type": "string" },
        "recordType": { "type": "string" },
        "department": { "type": "string" },
        "departmentLabel": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "archivedAt": { "type": "string" },
        "archivedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "recordId", "department", "archivedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Office department or committee with assigned employees and section permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "members": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "Staff account with exact-match login code, role, department, and section permissions",
      "type": "object",
      "properties": {
        "User_ID": { "type": "string" },
        "Username": { "type": "string" },
        "Password": { "type": "string" },
        "Phone": { "type": "string" },
        "Role": { "type": "string" },
        "RoleArabic": { "type": "string" },
        "FullName": { "type": "string" },
        "Department": { "type": "string" },
        "JobTitle": { "type": "string" },
        "Status": { "type": "string" },
        "Permissions": { "type": "array", "items": { "type": "string" } },
        "AllowedSections": { "type": "array", "items": { "type": "string" } },
        "CreatedAt": { "type": "string" },
        "UpdatedAt": { "type": "string" }
      },
      "required": ["User_ID", "Username", "Role", "FullName"]
    },
    "Referrer": {
      "title": "Referrer",
      "description": "Unified referrer entity consolidating similar name variations for the same person or source",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "canonicalName": { "type": "string" },
        "normalizedKey": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "usageCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "canonicalName", "normalizedKey"]
    },
    "BlacklistEntry": {
      "title": "BlacklistEntry",
      "description": "Blocked or rejected individual record with reason and audit metadata",
      "type": "object",
      "properties": {
        "Citizen_ID": { "type": "string" },
        "FullName": { "type": "string" },
        "normalizedName": { "type": "string" },
        "Phone1": { "type": "string" },
        "District": { "type": "string" },
        "BlockReason": { "type": "string" },
        "BlockedAt": { "type": "string" },
        "BlockedBy": { "type": "string" },
        "IsBlocked": { "type": "boolean" }
      },
      "required": ["Citizen_ID", "FullName", "BlockReason", "IsBlocked"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Concise operational audit log for add, edit, direct, archive, restore, and manual backup/import/export",
      "type": "object",
      "properties": {
        "Log_ID": { "type": "string" },
        "Timestamp": { "type": "string" },
        "UserName": { "type": "string" },
        "Action": { "type": "string" },
        "Department": { "type": "string" },
        "Details": { "type": "string" },
        "createdAtIso": { "type": "string" }
      },
      "required": ["Log_ID", "Timestamp", "Action"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global office configuration, outgoing counters, and manual Google Sheets backup status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appName": { "type": "string" },
        "deputyName": { "type": "string" },
        "googleSheetId": { "type": "string" },
        "googleSheetGid": { "type": "string" },
        "lastManualBackupAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "OfficeRequest": {
      "title": "OfficeRequest",
      "description": "Citizen administrative request and official transaction",
      "type": "object",
      "properties": {
        "Request_ID": { "type": "string" },
        "Citizen_ID": { "type": "string" },
        "CitizenName": { "type": "string" },
        "Entity": { "type": "string" },
        "RequestStatus": { "type": "string" },
        "ProcessingStatus": { "type": "string" },
        "Priority": { "type": "string" },
        "Details": { "type": "string" },
        "DirectorDecision": { "type": "string" },
        "DirectorNotes": { "type": "string" },
        "pathType": { "type": "string" },
        "route": { "type": "string" },
        "department": { "type": "string" },
        "TargetDepartment": { "type": "string" },
        "ArchivedAt": { "type": "string" },
        "ArchivedBy": { "type": "string" },
        "CreatedAt": { "type": "string" },
        "CreatedBy": { "type": "string" }
      },
      "required": ["Request_ID", "Citizen_ID", "Entity", "CreatedAt"]
    },
    "Interview": {
      "title": "Interview",
      "description": "Scheduled or documented citizen meeting with the MP or executive team",
      "type": "object",
      "properties": {
        "Interview_ID": { "type": "string" },
        "Citizen_ID": { "type": "string" },
        "Date": { "type": "string" },
        "Status": { "type": "string" }
      },
      "required": ["Interview_ID", "Citizen_ID"]
    },
    "OfficialLetter": {
      "title": "OfficialLetter",
      "description": "Issued official correspondence and ministerial memos",
      "type": "object",
      "properties": {
        "Letter_ID": { "type": "string" },
        "LetterNumber": { "type": "string" },
        "Recipient": { "type": "string" },
        "Subject": { "type": "string" }
      },
      "required": ["Letter_ID", "LetterNumber"]
    },
    "ChequeRecord": {
      "title": "ChequeRecord",
      "description": "Cheque financial assistance and distribution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "Citizen_ID": { "type": "string" },
        "Amount": { "type": "number" }
      },
      "required": ["id", "Citizen_ID"]
    },
    "OrganizationRecord": {
      "title": "OrganizationRecord",
      "description": "Organizational and community assessment records",
      "type": "object",
      "properties": {
        "Org_ID": { "type": "string" },
        "Citizen_ID": { "type": "string" }
      },
      "required": ["Org_ID", "Citizen_ID"]
    },
    "DropdownItem": {
      "title": "DropdownItem",
      "description": "Configurable dropdown option categories and values",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "Category": { "type": "string" },
        "ItemValue": { "type": "string" }
      },
      "required": ["id", "Category", "ItemValue"]
    },
    "CustomSection": {
      "title": "CustomSection",
      "description": "Dynamically added office departments and custom functional sections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "CustomSectionRecord": {
      "title": "CustomSectionRecord",
      "description": "Data records entered within dynamic custom sections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionId": { "type": "string" }
      },
      "required": ["id", "sectionId"]
    },
    "ArchiveDocument": {
      "title": "ArchiveDocument",
      "description": "Uploaded office archive document record linked to a citizen or correspondence",
      "type": "object",
      "properties": {
        "Doc_ID": { "type": "string" },
        "Citizen_ID": { "type": "string" },
        "CitizenName": { "type": "string" },
        "Title": { "type": "string" },
        "Category": { "type": "string" },
        "UploadedAt": { "type": "string" }
      },
      "required": ["Doc_ID", "Title"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time role-aware office alert and workflow notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "read"]
    }
  },
  "firestore": {
    "/visitors/{visitorId}": {
      "schema": "Visitor",
      "description": "Active citizen / visitor records filtered by department and status"
    },
    "/archives/{archiveId}": {
      "schema": "ArchiveEntry",
      "description": "Independent per-department archive entries with restore capability"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Office departments/committees and linked staff permissions"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Staff accounts and roles with exact-match login codes"
    },
    "/referrers/{referrerId}": {
      "schema": "Referrer",
      "description": "Unified referrers consolidating similar spellings under one canonical record"
    },
    "/blacklist/{citizenId}": {
      "schema": "BlacklistEntry",
      "description": "Blocked and rejected individuals registry"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Concise operational audit trail"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "System configuration, counters, and manual backup status"
    },
    "/requests/{requestId}": {
      "schema": "OfficeRequest",
      "description": "Citizen administrative requests"
    },
    "/interviews/{interviewId}": {
      "schema": "Interview",
      "description": "Parliamentary interview records"
    },
    "/letters/{letterId}": {
      "schema": "OfficialLetter",
      "description": "Official ministerial correspondence"
    },
    "/cheques/{chequeId}": {
      "schema": "ChequeRecord",
      "description": "Cheque distribution records"
    },
    "/organizations/{orgId}": {
      "schema": "OrganizationRecord",
      "description": "Organizational evaluations"
    },
    "/dropdowns/{dropdownId}": {
      "schema": "DropdownItem",
      "description": "System dropdown menus and categories"
    },
    "/custom_sections/{sectionId}": {
      "schema": "CustomSection",
      "description": "Dynamic office departments and custom modules"
    },
    "/custom_records/{recordId}": {
      "schema": "CustomSectionRecord",
      "description": "Records belonging to dynamic custom departments"
    },
    "/documents/{docId}": {
      "schema": "ArchiveDocument",
      "description": "Uploaded archive documents with real Firestore deleteDoc support"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time workflow notifications synchronized across office devices"
    }
  }
}
