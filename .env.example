# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# Vercel & Production Environment Variables (متغيرات بيئة Vercel للإنتاج)
# أضف هذه المتغيرات في Vercel -> Project Settings -> Environment Variables
# ثم قم بعمل Redeploy لتفعيل الاتصال المباشر مع Firebase و Google Sheets
# =========================================================================

# 1. Firebase Firestore & Auth Configuration (متغيرات مشروع Firebase)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# 2. Google Apps Script Web App URL (رابط تطبيق الويب بعد النشر - ينتهي بـ /exec)
VITE_GOOGLE_APPS_SCRIPT_URL=""

# 3. Google Sheet ID (معرف ملف شيت الإكسل المركزي)
VITE_GOOGLE_SHEET_ID=""

# 4. Google Drive Archive Folder ID (معرف مجلد أرشيف الصور والمستندات - اختياري)
VITE_GOOGLE_DRIVE_FOLDER_ID=""
